# Server Configuration
PORT=5000
NODE_ENV=production
APP_ORIGIN=https://your-frontend-domain.com
BASE_PATH=/api/v1

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dsa_tracker

# Email Service Configuration
EMAIL_URL=your-email-service-url
EMAIL_API_KEY=your-email-api-key

# Judge0 API Configuration (for code execution)
# Get API key from: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
